# Copy to .env and fill in. Never commit .env.
# Google OAuth client id (Web application). Used on /admin/login only; same value as GOOGLE_CLIENT_ID in backend/.env.
# Add http://localhost:5173 (and your production origin) to the client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Leave empty for local Vite proxying. Set to the backend Render service URL for deployment.
# Example: https://your-api.onrender.com (no trailing slash)
VITE_API_URL=
