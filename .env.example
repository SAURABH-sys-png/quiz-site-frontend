# Copy to .env and fill in. Never commit .env.
# Google OAuth client id (Web application). Used on /admin/login only; same value as GOOGLE_CLIENT_ID in backend/.env.
# Add http://localhost:5173 (and your production origin) to the client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Socket.IO host. Leave empty for local Vite proxying. In production set it to the backend's Railway origin
# (e.g. https://your-api.up.railway.app, no trailing slash). HTTP API calls always use this site's /api, which
# vercel.json rewrites to the backend.
VITE_API_URL=
